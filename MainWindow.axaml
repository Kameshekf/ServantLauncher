<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ServantLauncher.ViewModels"
        xmlns:views="using:ServantLauncher.Views"
        xmlns:controls="using:ServantLauncher.Controls"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="ServantLauncher.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Servant Launcher"
        Width="1200" Height="800"
        MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="72"
        Background="{DynamicResource BgDarkBrush}">

  <Grid>
    <!-- 1. BLURRED SERVER SCREENSHOT SLIDESHOW BACKGROUND -->
    <controls:SlideshowBackgroundControl />

    <!-- 2. MAIN APP STRUCTURE -->
    <Grid RowDefinitions="72,*">
      
      <!-- TOP NAVBAR & TITLEBAR -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          
          <!-- BRAND LOGO (Left) with BETA badge and Entrance Glow Animation -->
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Classes="logo-container" Classes.animated="{Binding IsLogoAnimationEnabled}" Width="44" Height="44" CornerRadius="14" Background="Transparent" ClipToBounds="False" Cursor="Hand">
              <Image Source="avares://ServantLauncher/Assets/Images/server-icon-rounded.png" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
            <TextBlock Text="SERVANT" Classes="heading" FontSize="19" FontWeight="Black" Foreground="White" LetterSpacing="1.5" VerticalAlignment="Center" />
            <Border Background="{DynamicResource BrandAccentAlphaBrush}" BorderBrush="{DynamicResource BrandAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center" Margin="2,0,0,0">
              <TextBlock Text="BETA" FontSize="9" FontWeight="Black" Foreground="{DynamicResource BrandAccentBrush}" LetterSpacing="1" />
            </Border>
          </StackPanel>

          <!-- NAVIGATION PILLS (Center - 3 tabs) -->
          <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource NavBgBrush}" CornerRadius="22" Padding="4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <RadioButton Content="Главная" Classes="nav-pill" IsChecked="{Binding SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" Click="OnHomeTabClicked" />
              <RadioButton Content="Сборки" Classes="nav-pill" IsChecked="{Binding SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" Click="OnProfilesTabClicked" />
              <RadioButton Content="Скриншоты" Classes="nav-pill" IsChecked="{Binding SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}" Click="OnScreenshotsTabClicked" />
              <RadioButton Content="Скины" Classes="nav-pill" IsVisible="{Binding IsMicrosoftAccountActive}" IsChecked="{Binding SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" Click="OnSkinsTabClicked" />
            </StackPanel>
          </Border>

          <!-- SETTINGS BUTTON + ACCOUNT CHIP (Right) -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            
            <!-- Settings Gear Button -->
            <Button Classes="btn-outline" Command="{Binding OpenSettingsDialogCommand}" ToolTip.Tip="Настройки лаунчера" Width="38" Height="38" Padding="0" CornerRadius="19">
              <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" Foreground="{DynamicResource TextBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <!-- User Account Chip -->
            <Button Classes="btn-outline" Command="{Binding OpenAccountsDialogCommand}" ToolTip.Tip="Сменить аккаунт или войти" Padding="6,4,14,4" CornerRadius="20">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource CardBgHoverBrush}" ClipToBounds="True" VerticalAlignment="Center">
                  <Panel>
                    <Image Source="{Binding ActiveAccount.HeadBitmap}" IsVisible="{Binding ActiveAccount.HasHeadBitmap}" Width="26" Height="26" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="None" />
                    <PathIcon Data="{StaticResource IconUser}" Width="13" Height="13" Foreground="{DynamicResource BrandAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !ActiveAccount.HasHeadBitmap}" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding ActiveAccount.Username, FallbackValue='Войти'}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- WINDOW CONTROLS (Minimize, Maximize, Close) -->
          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" Margin="14,0,0,0" VerticalAlignment="Center">
            <Button Classes="btn-outline" Command="{Binding MinimizeCommand}" Width="32" Height="32" Padding="0" CornerRadius="16" ToolTip.Tip="Свернуть">
              <PathIcon Data="{StaticResource IconMinimize}" Width="10" Height="10" Foreground="{DynamicResource TextBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="btn-outline" Command="{Binding MaximizeCommand}" Width="32" Height="32" Padding="0" CornerRadius="16" ToolTip.Tip="Развернуть">
              <PathIcon Data="{StaticResource IconMaximize}" Width="10" Height="10" Foreground="{DynamicResource TextBrightBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
            <Button Classes="btn-close" Command="{Binding CloseAppCommand}" Width="32" Height="32" Padding="0" CornerRadius="16" ToolTip.Tip="Закрыть">
              <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </StackPanel>

        </Grid>
      </Border>

      <!-- MAIN PAGE CONTENT (Tab Content) -->
      <Panel Grid.Row="1">
        <!-- Page 0: Home (Cinematic screen with play bar) -->
        <views:HomeView DataContext="{Binding HomeVm}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=0}" />

        <!-- Page 1: Profiles Grid & Details -->
        <views:ProfilesView DataContext="{Binding ProfilesVm}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=1}" />

        <!-- Page 2: Global Modrinth Catalog -->
        <views:ModrinthView DataContext="{Binding ModrinthVm}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=2}" />

        <!-- Page 3: Skins Management (Microsoft accounts) -->
        <views:SkinsView DataContext="{Binding SkinsVm}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=3}" />

        <!-- Page 4: Screenshots Gallery -->
        <views:ScreenshotsView DataContext="{Binding ScreenshotsVm}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).SelectedPageIndex, Converter={StaticResource IntEqualsConverter}, ConverterParameter=4}" />
      </Panel>

    </Grid>

    <!-- 3. UNIFIED BOTTOM STATUS BAR -->
    <controls:GlobalBottomStatusBar DataContext="{Binding GlobalProgress}" VerticalAlignment="Bottom" />

  </Grid>
</Window>
