<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <!-- Fonts -->
    <FontFamily x:Key="UnboundedFont">avares://ServantLauncher/Assets/Fonts/Unbounded/Unbounded-VariableFont_wght.ttf#Unbounded</FontFamily>
    <FontFamily x:Key="GoogleSansFont">avares://ServantLauncher/Assets/Fonts/Google_Sans/GoogleSans-VariableFont_GRAD,opsz,wght.ttf#Google Sans</FontFamily>

    <!-- Servant Dark Palette -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="#09080E" />
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#F20D0C13" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#DF13121A" />
    <SolidColorBrush x:Key="CardBgHoverBrush" Color="#F01A1924" />
    <SolidColorBrush x:Key="NavBgBrush" Color="#16151C" />
    <SolidColorBrush x:Key="PillActiveBgBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="PillActiveFgBrush" Color="White" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="BrandPurpleBrush" Color="#6D28D9" />
    <SolidColorBrush x:Key="BrandPurpleDarkBrush" Color="#4C1D95" />
    <SolidColorBrush x:Key="BrandPurpleLightBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#C084FC" />
    <SolidColorBrush x:Key="BtnOutlineBgBrush" Color="#14131C" />
    <SolidColorBrush x:Key="BtnOutlineHoverBgBrush" Color="#221F30" />
    <SolidColorBrush x:Key="BtnDangerBgBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="BtnDangerHoverBgBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="BorderCardBrush" Color="#28FFFFFF" />
    <SolidColorBrush x:Key="BorderPurpleBrush" Color="#50A855F7" />
    <SolidColorBrush x:Key="TextBrightBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="EmeraldOnlineBrush" Color="#34D399" />
  </Styles.Resources>

  <!-- Global Text Controls -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <!-- Bold & Punchy Headings -->
  <Style Selector="TextBlock.heading">
    <Setter Property="FontFamily" Value="{StaticResource UnboundedFont}" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>

  <!-- Glass Cards -->
  <Style Selector="Border.glass-card">
    <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Hero Logo Card (Instant, Smooth Hardware-Accelerated Hover Animation) -->
  <Style Selector="Border.hero-logo-card">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.hero-logo-card.animated:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <Style Selector="Border.glass-card:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderPurpleBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
  </Style>

  <!-- Header Logo Container (Smooth Hover Animation) -->
  <Style Selector="Border.logo-container">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.logo-container.animated:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.12)" />
  </Style>

  <!-- Primary Glow Button -->
  <Style Selector="Button.btn-primary">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.btn-primary:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Emerald Action Button (Green play/install) -->
  <Style Selector="Button.btn-emerald">
    <Setter Property="Background" Value="#10B981" />
    <Setter Property="Foreground" Value="#09090B" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="22,10" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.btn-emerald:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#34D399" />
    <Setter Property="Foreground" Value="#09090B" />
  </Style>

  <Style Selector="Button.btn-emerald:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Purple Brand Button -->
  <Style Selector="Button.btn-purple">
    <Setter Property="Background" Value="{DynamicResource BrandPurpleBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.btn-purple:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandPurpleLightBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.btn-purple:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Secondary Outline Button -->
  <Style Selector="Button.btn-outline">
    <Setter Property="Background" Value="{DynamicResource BtnOutlineBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.btn-outline:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BtnOutlineHoverBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderPurpleBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
  </Style>

  <Style Selector="Button.btn-outline:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Ghost / Invisible Card Button -->
  <Style Selector="Button.btn-ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.btn-ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.btn-ghost:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Window Close Button -->
  <Style Selector="Button.btn-close">
    <Setter Property="Background" Value="{DynamicResource BtnOutlineBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.btn-close:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#EF4444" />
    <Setter Property="BorderBrush" Value="#DC2626" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- Danger Button (Red) -->
  <Style Selector="Button.btn-danger">
    <Setter Property="Background" Value="{DynamicResource BtnDangerBgBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
        <BrushTransition Property="Background" Duration="0:0:0.2" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BtnDangerHoverBgBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.btn-danger:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!-- Navigation Pill Tab Button -->
  <Style Selector="RadioButton.nav-pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="18,8" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PillBorder"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <Border.Transitions>
            <Transitions>
              <BrushTransition Property="Background" Duration="0:0:0.2" />
              <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
            </Transitions>
          </Border.Transitions>
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.Foreground="{TemplateBinding Foreground}"
                            TextBlock.FontFamily="{TemplateBinding FontFamily}"
                            TextBlock.FontWeight="{TemplateBinding FontWeight}"
                            TextBlock.FontSize="{TemplateBinding FontSize}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.nav-pill:pointerover /template/ Border#PillBorder">
    <Setter Property="Background" Value="#22FFFFFF" />
  </Style>

  <Style Selector="RadioButton.nav-pill:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
  </Style>

  <Style Selector="RadioButton.nav-pill:checked /template/ Border#PillBorder">
    <Setter Property="Background" Value="{DynamicResource PillActiveBgBrush}" />
    <Setter Property="BorderBrush" Value="#40FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="RadioButton.nav-pill:checked">
    <Setter Property="Foreground" Value="{DynamicResource PillActiveFgBrush}" />
  </Style>

  <!-- Tab Pill Button (for Mod Details and inner tab bars) -->
  <Style Selector="Button.tab-pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.tab-pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1E1C28" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.tab-pill.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PillActiveBgBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>


  <!-- Sleek Neon ProgressBar -->
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="#201C2E" />
    <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Custom Modern TextBox -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource BtnOutlineBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBorderBrush}" />
    <Setter Property="Background" Value="{DynamicResource BtnOutlineHoverBgBrush}" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
    <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
  </Style>

  <!-- Custom ScrollBar -->
  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="7" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource BorderPurpleBrush}" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>

  <Style Selector="ScrollBar:vertical /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}" />
  </Style>

  <!-- ComboBox Modern Styling -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BtnOutlineBgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{DynamicResource BtnOutlineHoverBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBorderBrush}" />
  </Style>

  <Style Selector="ComboBox:focus /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
  </Style>

  <!-- ComboBox Popup Dropdown Container -->
  <Style Selector="ComboBox /template/ Popup Border#PopupBorder">
    <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderCardBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>

  <!-- ComboBox Items -->
  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrightBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Margin" Value="2,1" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontFamily" Value="{StaticResource GoogleSansFont}" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandAccentAlphaBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
  </Style>

  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrandPrimaryHoverBrush}" />
    <Setter Property="Foreground" Value="White" />
  </Style>
</Styles>
