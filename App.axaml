<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ServantLauncher.Converters"
             x:Class="ServantLauncher.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ServantLauncher/Styles/LucideIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <converters:IntEqualsConverter x:Key="IntEqualsConverter" />
      <converters:BoolToColorConverter x:Key="BoolToColorConverter" />
      <converters:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ServantLauncher/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
