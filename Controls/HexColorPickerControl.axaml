<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="ServantLauncher.Controls.HexColorPickerControl">

  <Border Background="#16151E" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="16" Padding="16">
    <StackPanel Spacing="14">
      
      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Палитра" Classes="heading" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
        <Button Grid.Column="1" Classes="btn-ghost" Click="OnCopyHexClicked" Padding="6,4" ToolTip.Tip="Скопировать HEX">
          <PathIcon Data="{StaticResource IconCopy}" Width="13" Height="13" Foreground="{DynamicResource TextMutedBrush}" />
        </Button>
      </Grid>

      <!-- 2D Color Spectrum Box + Color Preview -->
      <Border Height="160" CornerRadius="12" ClipToBounds="True" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Grid ColumnDefinitions="140,*">
          
          <!-- Selected Color Swatch (Left) -->
          <Border Grid.Column="0" x:Name="ColorPreviewBorder" Background="#7C3AED">
            <TextBlock Text="Текущий" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0.75" />
          </Border>

          <!-- 2D Saturation / Value Canvas (Right) -->
          <Panel Grid.Column="1" x:Name="SvPanel" PointerPressed="OnSvPointerPressed" PointerMoved="OnSvPointerMoved" PointerReleased="OnSvPointerReleased" Cursor="Cross">
            <!-- 1. Pure Hue Background -->
            <Border x:Name="HueBackgroundBorder" Background="#FF0000" />

            <!-- 2. Horizontal Saturation Gradient (White to Transparent) -->
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                  <GradientStop Color="#FFFFFFFF" Offset="0.0" />
                  <GradientStop Color="#00FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- 3. Vertical Value/Brightness Gradient (Transparent to Black) -->
            <Border>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00000000" Offset="0.0" />
                  <GradientStop Color="#FF000000" Offset="1.0" />
                </LinearGradientBrush>
              </Border.Background>
            </Border>

            <!-- Draggable Selector Circle -->
            <Canvas>
              <Ellipse x:Name="SvSelector" Width="18" Height="18" Stroke="White" StrokeThickness="2.5" Fill="Transparent" Margin="-9,-9,0,0">
                <Ellipse.Effect>
                  <DropShadowEffect Color="Black" BlurRadius="4" OffsetX="0" OffsetY="1" Opacity="0.8" />
                </Ellipse.Effect>
              </Ellipse>
            </Canvas>
          </Panel>

        </Grid>
      </Border>

      <!-- Rainbow Hue Slider -->
      <Border CornerRadius="8" ClipToBounds="True" Height="22" Padding="2,0">
        <Border.Background>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
            <GradientStop Color="#FF0000" Offset="0.00" />
            <GradientStop Color="#FFFF00" Offset="0.17" />
            <GradientStop Color="#00FF00" Offset="0.33" />
            <GradientStop Color="#00FFFF" Offset="0.50" />
            <GradientStop Color="#0000FF" Offset="0.67" />
            <GradientStop Color="#FF00FF" Offset="0.83" />
            <GradientStop Color="#FF0000" Offset="1.00" />
          </LinearGradientBrush>
        </Border.Background>
        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="270" ValueChanged="OnHueSliderValueChanged" Height="22" VerticalAlignment="Center" Background="Transparent" />
      </Border>

      <!-- Centered HEX Input Box with Copy Button -->
      <Border Background="#1C1A26" BorderBrush="{DynamicResource BorderCardBrush}" BorderThickness="1" CornerRadius="10" Padding="10,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Grid.Column="0" Text="HEX" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="6,0,10,0" />
          <TextBox Grid.Column="1" x:Name="HexInputBox" Text="#7C3AED" FontSize="14" FontWeight="Bold" Foreground="White" Background="Transparent" BorderThickness="0" TextAlignment="Center" TextChanged="OnHexInputTextChanged" />
          <Button Grid.Column="2" Classes="btn-ghost" Click="OnCopyHexClicked" Padding="6,4" ToolTip.Tip="Скопировать HEX код">
            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" Foreground="{DynamicResource BrandAccentBrush}" />
          </Button>
        </Grid>
      </Border>

      <!-- Color Formats Display Chips (RGB, CMYK, HSV, HSL) -->
      <Grid ColumnDefinitions="*,*,*,*">
        
        <!-- RGB -->
        <Border Grid.Column="0" Background="{DynamicResource BtnOutlineBgBrush}" CornerRadius="8" Padding="8,6" Margin="0,0,4,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="RGB" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="RgbText" Text="124, 58, 237" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- CMYK -->
        <Border Grid.Column="1" Background="{DynamicResource BtnOutlineBgBrush}" CornerRadius="8" Padding="8,6" Margin="2,0,2,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="CMYK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="CmykText" Text="48%, 76%, 0%, 7%" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- HSV -->
        <Border Grid.Column="2" Background="{DynamicResource BtnOutlineBgBrush}" CornerRadius="8" Padding="8,6" Margin="2,0,2,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="HSV" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="HsvText" Text="262°, 76%, 93%" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

        <!-- HSL -->
        <Border Grid.Column="3" Background="{DynamicResource BtnOutlineBgBrush}" CornerRadius="8" Padding="8,6" Margin="4,0,0,0">
          <StackPanel Spacing="2" HorizontalAlignment="Center">
            <TextBlock Text="HSL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
            <TextBlock x:Name="HslText" Text="262°, 82%, 58%" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
          </StackPanel>
        </Border>

      </Grid>

    </StackPanel>
  </Border>
</UserControl>
