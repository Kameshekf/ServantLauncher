<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="using:ServantLauncher.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100"
             x:Class="ServantLauncher.Controls.GlobalBottomStatusBar"
             x:DataType="services:IGlobalProgressService">

  <UserControl.Styles>
    <Style Selector="Border.status-drawer">
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="{DynamicResource HeaderBgBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderPurpleBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Height" Duration="0:0:0.2" Easing="CubicEaseOut" />
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>

    <!-- Expand on hover -->
    <Style Selector="Border.status-drawer:pointerover">
      <Setter Property="Height" Value="82" />
      <Setter Property="Background" Value="{DynamicResource CardBgHoverBrush}" />
    </Style>

    <!-- Hide compact row on hover -->
    <Style Selector="Border.status-drawer:pointerover Grid.compact-row">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Hide expanded details in collapsed state -->
    <Style Selector="Border.status-drawer Grid.expanded-details">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- Show expanded details on hover -->
    <Style Selector="Border.status-drawer:pointerover Grid.expanded-details">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </UserControl.Styles>

  <Border Classes="status-drawer" IsVisible="{Binding IsActive}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" ClipToBounds="True">
    <Grid RowDefinitions="Auto,*">
      
      <!-- TOP THIN PROGRESS LINE (Always visible) -->
      <ProgressBar Grid.Row="0"
                   Value="{Binding Percent}"
                   IsIndeterminate="{Binding IsIndeterminate}"
                   Minimum="0" Maximum="100"
                   Height="3"
                   Foreground="{DynamicResource BrandAccentBrush}"
                   Background="#20FFFFFF"
                   BorderThickness="0" />

      <!-- CONTENT CONTAINER -->
      <Grid Grid.Row="1" Margin="16,0,16,0" VerticalAlignment="Center">
        
        <!-- 1. COMPACT ROW (Visible when collapsed) -->
        <Grid Classes="compact-row" ColumnDefinitions="Auto,*,Auto" Height="25" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <PathIcon Data="{StaticResource IconDownload}" Width="11" Height="11" Foreground="{DynamicResource BrandAccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="350" />
            <TextBlock Text="—" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="Наведите для подробностей" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.6" />
            <Border Background="{DynamicResource BrandPrimaryBrush}" CornerRadius="6" Padding="6,2">
              <TextBlock Text="{Binding Percent, StringFormat='{}{0:F0}%'}" FontSize="10" FontWeight="Black" Foreground="White" />
            </Border>
          </StackPanel>
        </Grid>

        <!-- 2. EXPANDED DETAILS (Revealed cleanly on hover, compact row is hidden) -->
        <Grid Classes="expanded-details" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
          <StackPanel Grid.Column="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Black" Foreground="White" />
              <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BrandAccentBrush}" BorderThickness="1" CornerRadius="6" Padding="6,1">
                <TextBlock Text="{Binding Percent, StringFormat='{}{0:F0}%'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrandAccentBrush}" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding DetailLog}" FontSize="10" Foreground="{DynamicResource BrandAccentBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding DetailLog, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Text="{Binding SpeedText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource EmeraldOnlineBrush}" VerticalAlignment="Center" IsVisible="{Binding SpeedText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Classes="btn-danger" Command="{Binding Cancel}" Content="Отмена" Padding="14,6" FontSize="11" FontWeight="Bold" CornerRadius="12" IsVisible="{Binding CanCancel}" />
          </StackPanel>
        </Grid>

      </Grid>

    </Grid>
  </Border>
</UserControl>
